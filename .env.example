# Environment Variables Template
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# In local development, SQLite fallback or local PostgreSQL can be used
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://sentinel_user:sentinel_password@localhost:5432/sentinel_db

# Redis Configuration (Optional in dev, in-memory fallback enabled)
REDIS_URL=redis://localhost:6379/0

# Security Keys
API_SECRET_KEY=sentinel_jwt_and_hmac_super_secret_key_change_me
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ML Threshold Defaults
RISK_THRESHOLD_ALLOW=30.0
RISK_THRESHOLD_CHALLENGE=75.0
