# SentinelAI Environment Variables Template

# Application Environment
ENVIRONMENT=production
DEBUG=False
APP_NAME=SentinelAI Real-Time Fraud Engine

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_password_change_in_prod
POSTGRES_DB=sentinel_db
DATABASE_URL=postgresql+asyncpg://sentinel_user:sentinel_password_change_in_prod@postgres:5432/sentinel_db

# Redis Caching & Message Queue
REDIS_URL=redis://redis:6379/0

# Security & JWT Authentication
API_SECRET_KEY=sentinel_jwt_and_hmac_super_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,*
HMAC_ENABLED=False

# ML Engine & Ensemble Weights
RISK_THRESHOLD_ALLOW=30.0
RISK_THRESHOLD_CHALLENGE=75.0
WEIGHT_ML=0.50
WEIGHT_RULES=0.30
WEIGHT_BEHAVIORAL=0.20
